# BrandShield Frontend Environment Configuration
# FastAPI Backend Base URL (e.g., http://localhost:8000 or production API gateway)
VITE_API_BASE_URL=http://localhost:8000

# Toggle between simulated local mock engine and live FastAPI backend
# Set to 'false' once your FastAPI server is running with the specified endpoints
VITE_USE_MOCK_DATA=true

# Security Note: Never expose AI API keys (OpenAI, Anthropic, Gemini) in frontend environment variables.
# All LLM inference, vector embedding generation, and OCR extraction must be executed server-side via FastAPI.
