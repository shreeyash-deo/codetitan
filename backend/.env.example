# BrandShield Backend Environment Configuration

# Database
# For PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandshield
# For local SQLite development/testing fallback:
# DATABASE_URL=sqlite:///./brandshield.db

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS
FRONTEND_URL=http://localhost:5173

# Application
ENVIRONMENT=development
PROJECT_NAME="BrandShield API"
UPLOAD_DIR=./uploads

# AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
