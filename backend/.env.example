# BrandShield Backend Environment Configuration

# Database
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandshield
# For local SQLite development/testing:
DATABASE_URL=sqlite:///./brandshield.db

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS
FRONTEND_URL=http://localhost:5173

# Application
ENVIRONMENT=development
PROJECT_NAME="BrandShield API"
UPLOAD_DIR=./uploads

# AI Provider Configuration
AI_PROVIDER=gemini

# Gemini Credentials
# Precedence: GEMINI_API_KEY is preferred. GOOGLE_API_KEY is supported as optional fallback.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Gemini Model
# Precedence: GEMINI_MODEL is preferred. AI_MODEL is supported as fallback.
# Supported Google Generative Language models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# AI Request Settings
AI_TEMPERATURE=0.2
AI_TIMEOUT=45
AI_MAX_RETRIES=2

# Alternative Provider (Optional)
DEEPSEEK_API_KEY=
